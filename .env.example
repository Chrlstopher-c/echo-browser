# Emplacement de la distribution CEF (libcef.so). Defaut : ~/.local/share/cef
CEF_PATH=

# Profil du navigateur : base SQLite, cache, extensions installees.
# Defaut : ~/.local/share/echo-browser
ECHO_DATA_DIR=

# Dossier des fichiers d'interface servis par echo://. Defaut : ./ui/dist
ECHO_UI_DIR=

# Met a 1 pour rejouer le scenario d'auto-controle sans interface.
ECHO_SELFTEST=
