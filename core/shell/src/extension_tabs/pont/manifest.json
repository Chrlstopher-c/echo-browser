{
  "manifest_version": 3,
  "name": "Echo — pont interne des extensions",
  "description": "Interne a Echo : relie les onglets d'Echo aux extensions, et garde a chaque profil ses propres extensions.",
  "version": "1.0",
  "key": "",
  "permissions": [
    "debugger",
    "management",
    "cookies"
  ],
  "background": {
    "service_worker": "pont.js"
  },
  "host_permissions": [
    "https://echo-profil.invalid/*"
  ]
}
